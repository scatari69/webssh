{
	# Почта для Let's Encrypt подставляется целой директивой, а не значением.
	#
	# Причина практическая: `email {$ACME_EMAIL}` с незаполненной переменной
	# разворачивается в `email` без аргумента, и Caddy отказывается разбирать
	# конфигурацию целиком — контейнер уходит в перезапуск с сообщением про
	# «wrong argument count», по которому причину не угадать. Строку целиком
	# собирает docker-compose (ACME_EMAIL:+email ...), поэтому пустая
	# переменная даёт пустую строку, а не сломанный конфиг.
	{$ACME_EMAIL_DIRECTIVE}

	# На время отладки конфига раскомментируйте staging-CA в .env
	# (ACME_CA_DIRECTIVE=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory).
	# У боевого Let's Encrypt лимит — 5 одинаковых сертификатов в неделю,
	# и исчерпать его при настройке очень легко. Сертификаты staging
	# браузером не доверяются, это ожидаемо.
	{$ACME_CA_DIRECTIVE}

	# Доверяем заголовкам X-Forwarded-* только от частных адресов, то есть
	# от самого себя. Приложение, в свою очередь, доверяет ровно одному
	# прокси (trust proxy = 1): иначе клиент подделал бы свой адрес в
	# X-Forwarded-For и обошёл лимит попыток входа и запись в журнале.
	servers {
		trusted_proxies static private_ranges
	}
}

# DOMAIN=localhost — Caddy выпустит сертификат своего внутреннего CA
# и не пойдёт в ACME. Удобно для локальной проверки docker compose up.
#
# Для боевого домена ничего включать не нужно: HTTPS, выпуск и продление
# сертификата Let's Encrypt, а также редирект с http:// Caddy делает сам,
# как только видит имя, отличное от localhost.
{$DOMAIN} {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	header {
		# HSTS без includeSubDomains — на домене могут жить соседние сервисы.
		# preload намеренно не включён: попадание в preload-список браузеров
		# откатывается месяцами, это отдельное осознанное решение.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"

		# Приложению не нужен ни один из этих механизмов. Отзыв прав здесь
		# не про сам интерфейс, а про то, во что он превратится, если через
		# XSS на страницу попадёт чужой код.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

		# Шлюз к SSH-хосту в поисковой выдаче не нужен: это лишняя наводка
		# для перебора, а пользы от индексации нет никакой.
		X-Robots-Tag "noindex, nofollow, noarchive"

		# Версия сервера — бесплатная подсказка о том, какие уязвимости
		# пробовать.
		-Server
	}

	# --------------------------------------------------------- WebSocket
	#
	# Отдельный блок для /ws/* заведён ради таймаутов и буферизации, а не
	# ради самого Upgrade: Caddy — HTTP/1.1-прокси и переключение протокола
	# проксирует прозрачно, сам управляя hop-by-hop заголовками Connection
	# и Upgrade.
	#
	# Выставлять их здесь вручную (header_up Connection Upgrade) — частая и
	# вредная привычка из конфигов nginx: Caddy тогда получит два набора
	# hop-by-hop заголовков, а клиент по HTTP/2 или HTTP/3, где Connection
	# запрещён вовсе, получит сломанное рукопожатие. Матчер ниже как раз и
	# опирается на настоящие заголовки клиента, а не подменяет их.
	@websocket {
		path /ws/*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy {$APP_UPSTREAM} {
			# Поток PTY интерактивный: буферизация здесь означала бы
			# задержку между нажатием клавиши и эхом на экране.
			flush_interval -1
		}
	}

	# ------------------------------------------------------------- REST
	handle {
		# Потолок тела запроса. Приложение ограничивает JSON 256 КиБ само,
		# но там лимит срабатывает уже после того, как данные приняты
		# процессом Node; здесь — до того, и лишний мегабайт обрывается на
		# входе. Самое большое законное тело — приватный ключ.
		request_body {
			max_size 1MB
		}

		reverse_proxy {$APP_UPSTREAM} {
			# X-Forwarded-For, -Proto и -Host Caddy проставляет сам; на них
			# опираются лимит попыток входа и адреса в журнале.
			#
			# Активная проба даёт быстрый и понятный 502 вместо повисших
			# запросов, пока приложение перезапускается. Интервал короткий
			# намеренно: апстрим здесь один, и пока Caddy считает его
			# упавшим, наружу идут отказы — при 30 секундах пользователи
			# получали бы 502 ещё полминуты после того, как приложение уже
			# поднялось.
			health_uri /api/health
			health_interval 10s
			health_timeout 5s
		}
	}

	handle_errors {
		# Наружу — только код. Тексты ошибок прокси иногда содержат адрес
		# и порт апстрима.
		respond "{err.status_code} {err.status_text}"
	}
}
