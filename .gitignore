node_modules/

# Секреты окружения. Шаблон .env.example — единственное исключение:
# он не содержит значений, только имена переменных и пояснения.
.env
.env.*
!.env.example

# Каталоги данных подключаются в контейнеры bind-mount'ом из каталога
# проекта, поэтому лежат прямо здесь: база, приватный ключ и выпущенные
# сертификаты Let's Encrypt.
#
# Без ведущего слэша — правило действует на любой глубине: каталог,
# случайно созданный в server/ или в подпапке, тоже не должен попасть
# в историю. Вернуть секрет из истории git нельзя.
keys/
data/
caddy/config/
*.key
*.pem
id_rsa
id_ed25519
id_ecdsa
known_hosts

*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

*.log
npm-debug.log*
.DS_Store

# Снимки экрана сквозных проверок: полезны, когда набор упал, и
# бесполезны в истории — каждый прогон переписывает их заново.
server/test/e2e/shots/
