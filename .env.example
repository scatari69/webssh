# Скопируйте в .env и заполните:  cp .env.example .env
#
# Сгенерировать секреты:
#   SESSION_SECRET:  openssl rand -base64 48
#   ENCRYPTION_KEY:  openssl rand -base64 32     (ровно 32 байта после декодирования)

# ---------------------------------------------------------------- приложение
# Порт, который слушает backend внутри своей сети. Наружу не публикуется —
# снаружи доступен только Caddy на 80/443.
PORT=3000

# Публичный origin приложения. Используется для проверки заголовка Origin
# при WebSocket-upgrade (защита от cross-site WebSocket hijacking).
# Должен совпадать с тем, что реально вводит пользователь в браузере.
PUBLIC_ORIGIN=https://webssh.example.com

# ------------------------------------------------------------------ секреты
# Подпись cookie сессии. Смена значения разлогинивает всех.
SESSION_SECRET=

# Мастер-ключ шифрования секретов в БД (AES-256-GCM): passphrase от SSH-ключа,
# TOTP-секреты. 32 байта в base64.
# Потеря ключа = эти поля не расшифровать; восстановление — заново ввести
# данные в админке. Пароли пользователей не затрагиваются (bcrypt, отдельно).
ENCRYPTION_KEY=

# Идентификатор текущего ключа (1..255). Пишется в каждый шифроблоб и позволяет
# ротацию: поднимите ID, положите новый ключ в ENCRYPTION_KEY, а старый —
# в ENCRYPTION_KEY_PREVIOUS/_ID, чтобы старые записи ещё читались.
ENCRYPTION_KEY_ID=1
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_ID=

# Альтернатива для docker secrets — путь к файлу вместо значения в окружении.
# Если задано, имеет приоритет над переменной выше. Предпочтительный способ
# в бою: переменные окружения видны в `docker inspect` и /proc/<pid>/environ.
# SESSION_SECRET_FILE=/run/secrets/session_secret
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key

# ---------------------------------------------------------------- хранилище
# Пути внутри контейнера. Смонтированы как именованные docker-volume.
DB_PATH=/data/webssh.sqlite
SSH_KEYS_DIR=/keys

# --------------------------------------------------------------- первый вход
# Пароль админа, создаваемого при первом запуске (когда таблица users пуста).
# Если оставить пустым — пароль будет сгенерирован и один раз напечатан в лог
# контейнера. После первого входа переменную можно убрать из .env.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------- сессии
SESSION_IDLE_TIMEOUT_MS=28800000
SESSION_ABSOLUTE_TIMEOUT_MS=604800000

# --------------------------------------------------------------------- TOTP
# Для роли admin двухфакторка обязательна, для user — по желанию.
# Поставьте 0, если обязательность для админов не нужна.
TOTP_REQUIRED_FOR_ADMIN=1
TOTP_ISSUER=webssh

# ------------------------------------------------------------- ограничения
MAX_SESSIONS_PER_USER=3
MAX_SESSIONS_TOTAL=50
IDLE_TIMEOUT_MS=1800000
DETACH_GRACE_MS=120000
REPLAY_BUFFER_BYTES=262144

# Список CIDR, которым разрешён доступ. Пусто = allowlist выключен.
# Пример: IP_ALLOWLIST=203.0.113.0/24,198.51.100.7/32
IP_ALLOWLIST=

# Заградительный лимит на /api/auth/login, до обращения к bcrypt.
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_THRESHOLD=5

# ---------------------------------------------------------------- аудит
AUDIT_RETENTION_DAYS=365

# --------------------------------------------------------------------- Caddy
# Домен, на который Caddy выпустит сертификат Let's Encrypt.
# Для локальной проверки поставьте localhost — Caddy выдаст сертификат
# своего внутреннего CA, ACME при этом не задействуется.
DOMAIN=webssh.example.com
ACME_EMAIL=redcat@edge.kiev.ua

# Переопределение ACME-сервера. Задаётся ЦЕЛИКОМ директивой, потому что
# Caddy подставляет переменные до разбора конфига: пустое значение должно
# давать пустую строку, а не директиву без аргумента.
# Раскомментируйте на время отладки, чтобы не жечь лимиты боевого
# Let's Encrypt (5 одинаковых сертификатов в неделю):
# ACME_CA_DIRECTIVE=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_DIRECTIVE=
